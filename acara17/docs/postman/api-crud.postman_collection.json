{
  "info": {
    "name": "Sistem Informasi Akademik - API CRUD (BKPM Acara 17)",
    "description": "Ubah variabel base_url sesuai nama folder project, contoh: http://localhost/sistem-informasi-akademik/public. Jalankan request 1 sampai 6 berurutan (request 1 menyimpan mhs_id).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/sistem-informasi-akademik/public"
    },
    {
      "key": "mhs_id",
      "value": ""
    },
    {
      "key": "prodi_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A. CRUD Mahasiswa",
      "item": [
        {
          "name": "1. POST tambah mahasiswa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"mhs_id\", d.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/mahasiswa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mahasiswa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nim\": \"{{$timestamp}}\",\n    \"nama\": \"Andi Saputra\",\n    \"prodi_id\": 1,\n    \"angkatan\": 2026,\n    \"status\": \"aktif\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. GET seluruh mahasiswa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"data berupa array\", function () { pm.expect(pm.response.json().data).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mahasiswa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mahasiswa"
              ]
            }
          }
        },
        {
          "name": "3. GET mahasiswa berdasarkan id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"nama Andi Saputra\", function () { pm.expect(pm.response.json().data.nama).to.eql(\"Andi Saputra\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mahasiswa?id={{mhs_id}}",
