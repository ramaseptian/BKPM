{
  "info": {
    "name": "SI Akademik - RESTful API Mahasiswa (BKPM Acara 16)",
    "description": "Variabel base_url default http://localhost/si-akademik. Request 3 menyimpan new_id dan new_nim untuk request 4 dan 5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/si-akademik"
    },
    {
      "key": "new_id",
      "value": ""
    },
    {
      "key": "new_nim",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A. Endpoint CRUD",
      "item": [
        {
          "name": "1. GET seluruh mahasiswa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"data berupa array\", function () { pm.expect(pm.response.json().data).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mahasiswa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mahasiswa"
              ]
            }
          }
        },
        {
          "name": "2. GET mahasiswa berdasarkan ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"data berupa object\", function () { pm.expect(pm.response.json().data).to.have.property(\"nim\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mahasiswa/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mahasiswa",
                "1"
              ]
            }
          }
        },
        {
          "name": "3. POST tambah mahasiswa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });",
                  "var d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"new_id\", d.id);",
                  "pm.collectionVariables.set(\"new_nim\", d.nim);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mahasiswa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mahasiswa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nim\": \"{{$timestamp}}\",\n    \"nama\": \"Rina\",\n    \"prodi_id\": 1,\n    \"angkatan\": 2026,\n    \"status\": \"aktif\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4. PUT ubah mahasiswa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"nama berubah\", function () { pm.expect(pm.response.json().data.nama).to.eql(\"Rina Aprilia\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mahasiswa/{{new_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mahasiswa",
                "{{new_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nim\": \"{{new_nim}}\",\n    \"nama\": \"Rina Aprilia\",\n    \"prodi_id\": 2,\n    \"angkatan\": 2025,\n    \"status\": \"cuti\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5. DELETE hapus mahasiswa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mahasiswa/{{new_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mahasiswa",
                "{{new_id}}"
              ]
            }
          }
        }
      ]
    },
