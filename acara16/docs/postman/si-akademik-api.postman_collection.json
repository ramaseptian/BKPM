{
  "info": {
    "name": "SI Akademik - API Mahasiswa (BKPM Acara 15)",
    "description": "Koleksi pengujian API Mahasiswa. Atur variabel base_url (default http://localhost/si-akademik).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/si-akademik"
    }
  ],
  "item": [
    {
      "name": "1. GET semua mahasiswa",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });",
              "pm.test(\"data berupa array\", function () { pm.expect(pm.response.json().data).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/mahasiswa.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mahasiswa.php"
          ]
        }
      }
    },
    {
      "name": "2. GET semua mahasiswa (tanpa .php)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/mahasiswa",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mahasiswa"
          ]
        }
      }
    },
    {
      "name": "3. GET mahasiswa id=1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response berupa JSON\", function () { pm.response.to.be.json; });",
              "pm.test(\"data berupa object\", function () { pm.expect(pm.response.json().data).to.have.property(\"nim\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/mahasiswa.php?id=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mahasiswa.php"
          ],
          "query": [
            {
              "key": "id",
              "value": "1"
            }
          ]
        }
      }
    },
